type User {
  id: ID!
  email: String!
  createdAt: Time!
}

extend type Query {
  "The signed-in user, or null when the request is anonymous."
  me: User
}

"""
A session token handed to the client to keep, for callers that have no
cookie jar. A browser should never ask for one: script that can read a
credential is script that can leak it.
"""
type AccessToken {
  token: String!
  expiresAt: Time!
  user: User!
}

extend type Mutation {
  """
  Signs in and returns the token itself, for native apps.

  Same credentials and same token as `logIn`; only the way it travels
  differs. The app is expected to keep it somewhere the operating system
  protects — the keychain on iOS, the keystore on Android — and send it as
  `Authorization: Bearer <token>`.
  """
  createAccessToken(email: String!, password: String!): AccessToken!

  """
  Register and start a session. The session is a signed token in an HttpOnly
  cookie, so it is never readable from JavaScript.
  """
  signUp(email: String!, password: String!): User!

  logIn(email: String!, password: String!): User!

  "Ends the session. Always returns true, including when nobody was signed in."
  logOut: Boolean!
}
